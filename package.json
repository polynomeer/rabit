{
  "name": "rabit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "preflight": "node scripts/preflight.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:user": "node scripts/demo.mjs user",
    "db:reset": "node scripts/db-reset.mjs",
    "db:reset:test": "node scripts/db-reset.mjs --test",
    "infra:up": "docker compose up -d --wait postgres s3 && docker compose run --rm s3-init",
    "infra:down": "docker compose down",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @rabit/server migrate:up",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "verify": "node scripts/verify.mjs",
    "e2e": "pnpm --filter @rabit/web e2e",
    "e2e:local": "node scripts/e2e-local.mjs",
    "alerts:check": "docker run --rm --entrypoint sh -v \"$PWD/infra/observability:/w:ro\" -w /w prom/prometheus:v3.15.0 -c 'promtool check rules alerts.yml && promtool test rules alerts.test.yml'",
    "gameday": "bash infra/gameday/run.sh",
    "worktree": "node scripts/worktree.mjs",
    "ios:check": "node scripts/ios-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
