# Copy to apps/server/.env for local development. Values are validated at startup.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=8080
MEDIA_PORT=8081
METRICS_PORT=9464
API_PUBLIC_BASE_URL=http://localhost:8080
MEDIA_PUBLIC_BASE_URL=http://localhost:8081

DATABASE_URL=postgres://rabit:rabit@127.0.0.1:55440/rabit

S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
# Static keys for the local S3 server; leave both unset on AWS (the task's IAM role is used).
S3_ACCESS_KEY_ID=rabit
S3_SECRET_ACCESS_KEY=rabit-dev-secret
S3_FORCE_PATH_STYLE=true
# Physical buckets are <prefix>-quarantine, <prefix>-private-media, ... (ADR-0004).
S3_BUCKET_PREFIX=rabit
# Production requires aws:kms with a customer-managed key (S3_SSE_KMS_KEY_ID).
S3_SSE=AES256

# OIDC (ADR-0009). Local development uses the built-in dev issuer.
AUTH_ISSUER=http://localhost:8080/dev
AUTH_AUDIENCE=rabit-api
AUTH_JWKS_URL=
AUTH_DEV_ISSUER_ENABLED=true
# Production on Cognito (ADR-0009): AUTH_PROFILE=cognito, AUTH_AUDIENCE=<web app client id>,
# and the MFA-required operator pool in AUTH_OPERATOR_ISSUER / _JWKS_URL / _AUDIENCE.
AUTH_PROFILE=standard

# Secrets: at least 32 characters. Generate with: openssl rand -base64 48
MEDIA_TOKEN_SECRET=dev-only-media-token-secret-change-me-0123456789
CURSOR_SECRET=dev-only-cursor-secret-change-me-0123456789abcdef

WORKER_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate-limit counters shared by every api instance (ADR-0020); memory is refused in production.
RATE_LIMIT_STORE=postgres

# Album purchase with the sandbox provider (ADR-0018, provisional); refused in production.
PAYMENTS_PROVIDER=mock
PAYMENTS_MOCK_WEBHOOK_SECRET=dev-only-mock-pay-secret-change-me-0123456789
